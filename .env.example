# Docker production environment. Generate .env with scripts/init-docker-env.py.
# Keep .env private. These values go to Django only, never into the web image.
SKILLFORGE_HTTP_PORT=3830
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=brollysolutions.in,localhost,127.0.0.1
FRONTEND_URL=https://brollysolutions.in/skillforge
CORS_ALLOWED_ORIGINS=https://brollysolutions.in
CSRF_TRUSTED_ORIGINS=https://brollysolutions.in
# Parent-domain HSTS remains the responsibility of the existing TLS proxy.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_DAILY_LIMIT=100
CODE_EXECUTION_PROVIDER=piston
# Private address of a separately isolated runner, ending /api/v2.
# 127.0.0.1 inside the API container is NOT your server or another container.
PISTON_URL=
PISTON_PYTHON_VERSION=3.x
PISTON_API_TOKEN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL='SkillForge AI <noreply@brollysolutions.in>'
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
MAX_UPLOAD_MB=10
