DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional path prefix when the reverse proxy strips /skillforge before forwarding
DJANGO_SCRIPT_NAME=
CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL=false
# HSTS is domain-wide: coordinate these with the existing main website
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_DAILY_LIMIT=100
CODE_EXECUTION_PROVIDER=piston
# Full API base URL on your isolated Piston host, e.g. http://127.0.0.1:2000/api/v2 via an SSH tunnel
PISTON_URL=
PISTON_PYTHON_VERSION=3.x
# Optional bearer token for your own authenticated reverse proxy
PISTON_API_TOKEN=
# Optional legacy runner (select CODE_EXECUTION_PROVIDER=judge0)
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
JUDGE0_PYTHON_LANGUAGE_ID=71
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SkillForge AI <noreply@example.com>
MAX_UPLOAD_MB=10
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
