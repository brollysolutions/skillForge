# Install as /etc/skillforge/skillforge.env, readable only by the service user/root.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-32-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=brollysolutions.in
DJANGO_SCRIPT_NAME=/skillforge
FRONTEND_URL=https://brollysolutions.in/skillforge
CORS_ALLOWED_ORIGINS=https://brollysolutions.in
CSRF_TRUSTED_ORIGINS=https://brollysolutions.in
DJANGO_DB_PATH=/var/lib/skillforge/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/skillforge/media
DJANGO_STATIC_ROOT=/srv/skillforge/staticfiles
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Waitress sets wsgi.url_scheme=https; it listens only on loopback.
DJANGO_TRUST_PROXY_SSL=false
# Leave parent-domain HSTS policy under control of the existing site administrator.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
AI_DAILY_LIMIT=100
CODE_EXECUTION_PROVIDER=piston
# Your private isolated runner or tunnel; installing the app does not install Piston.
PISTON_URL=
PISTON_PYTHON_VERSION=3.x
PISTON_API_TOKEN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SkillForge AI <noreply@brollysolutions.in>
MAX_UPLOAD_MB=10
